# GEMINI_API_KEY: Unused in GpnFlix (kept commented for template compatibility).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TMDB_API_KEY: Clé API gratuite The Movie Database (v3 API Key ou v4 Read Access Token).
# Configurez votre clé dans le panneau Secrets de Google AI Studio.
# Si non renseignée, GpnFlix utilise automatiquement l'API publique sans clé d'Internet Archive (Archive.org).
TMDB_API_KEY=MY_TMDB_API_KEY
